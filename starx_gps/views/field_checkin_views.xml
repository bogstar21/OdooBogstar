<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_field_checkin_list" model="ir.ui.view">
        <field name="name">field.checkin.list</field>
        <field name="model">field.checkin</field>
        <field name="arch" type="xml">
            <tree string="Check-ins">
                <field name="checkin_at"/>
                <field name="worker_id"/>
                <field name="point_id"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="view_field_checkin_form" model="ir.ui.view">
        <field name="name">field.checkin.form</field>
        <field name="model">field.checkin</field>
        <field name="arch" type="xml">
            <form string="Check-in">
                <sheet>
                    <group>
                        <field name="worker_id"/>
                        <field name="point_id"/>
                        <field name="checkin_at"/>
                        <field name="latitude"/>
                        <field name="longitude"/>
                        <field name="note"/>
                        <field name="photo" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_field_checkin" model="ir.actions.act_window">
        <field name="name">Check-ins</field>
        <field name="res_model">field.checkin</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Employees: link to their no-login check-in page + the regenerate-token action -->
    <record id="view_hr_employee_form_checkin" model="ir.ui.view">
        <field name="name">hr.employee.form.checkin.token</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="StarX GPS — Check-in link" name="starx_gps_checkin">
                    <field name="checkin_url" widget="url" readonly="1" string="Share this link with the worker"/>
                    <button name="action_regenerate_checkin_token" type="object"
                            string="Regenerate check-in link" class="btn-link"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_form_worker" model="ir.ui.view">
        <field name="name">res.partner.form.field.worker</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="field_worker_id"/>
                <!-- Normally these are dev-mode-only fields. Surfacing them here lets
                     an admin set a starting location for a point BEFORE anyone has
                     ever checked in there — otherwise the Planner can't route to a
                     brand-new point at all (see Plan-StarX-Odoo.md, MVP gap B). A
                     real check-in still won't overwrite them once set (see
                     field_checkin.py's create()). -->
                <label for="partner_latitude" string="GPS (for GPS Intelligence)"/>
                <div class="o_row">
                    <field name="partner_latitude" placeholder="Latitude"/>
                    <field name="partner_longitude" placeholder="Longitude"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
